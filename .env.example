# =============================================================================
# AgentConnect AI — Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.

# --- Database (PostgreSQL + pgvector) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentconnect
DB_USER=agentconnect
DB_PASSWORD=agentconnect123

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Security ---
JWT_SECRET=your-secret-key-change-in-production

# --- AI Provider ---
# Options: mock, openai, anthropic
AI_PROVIDER=mock
EMBEDDING_DIMENSIONS=768
AI_MODEL=gpt-4

# --- OpenAI (when AI_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...

# --- Anthropic (when AI_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
